RewriteEngine On
RewriteBase /

# Serve real files and directories exactly as they are (JS, CSS, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else (client-side routes) falls back to index.html
RewriteRule ^ index.html [L]
